amends "package://github.com/jdx/hk/releases/download/v2.1.0/hk@2.1.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.1.0/hk@2.1.0#/Builtins.pkl"
import "hk-vendored.pkl" as vendored

// Overlay patches are byte-exact: a context line is " " plus the original line,
// so stripping its trailing space makes the patch stop applying. Fixers that
// rewrite bytes must leave them alone, same as the vendored snapshots.
local unformattable = vendored.globs + List("vendor-overlays/**/*.patch")

steps {
    ["check-merge-conflict"] = Builtins.check_merge_conflict
    ["check-added-large-files"] = Builtins.check_added_large_files
    ["trailing-whitespace"] = (Builtins.trailing_whitespace) {
        exclude = unformattable
    }
    ["newlines"] = (Builtins.newlines) {
        exclude = unformattable
    }
    ["gitleaks"] = Builtins.gitleaks
    ["oxfmt"] = (Builtins.oxfmt) {
        glob = List("**/*.md", "**/*.markdown")
        exclude = vendored.globs
    }
}

hooks {
    ["commit-msg"] {
        steps {
            ["conventional-commit"] = Builtins.check_conventional_commit
        }
    }
}
